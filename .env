# Optional legacy fallback: a single shared "X-API-Key" for /api/public/*
# routes, only used if no key has been generated yet from the app's
# Settings → API keys page (the preferred way — proper key + secret pairs,
# generated and manageable in-app). If unset and no generated key exists
# either, those routes are open (fine for local testing only).
WEBSITE_API_KEY="change-this-too"

# --- Optional: email alerts & backups (low-stock alert + weekly backup cron) ---
# Leave these unset and the app works fine — those two emails just won't be
# sent until you fill them in. A free Gmail account works: turn on 2-Step
# Verification, then create an "App password" at
# https://myaccount.google.com/apppasswords and use that as SMTP_PASS.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="fitna445@gmail.com"
SMTP_PASS="pahc zzrc fqwj qpkd"
SMTP_FROM="fitna445@gmail.com"

# --- Optional but recommended: protects /api/cron/* from being called by
# anyone who finds the URL. On Vercel, set the exact same value as a
# project env var — Vercel then automatically sends it as
# `Authorization: Bearer <value>` when it triggers your cron jobs (see
# vercel.json). Generate one with: openssl rand -base64 32
CRON_SECRET="change-this-too"

